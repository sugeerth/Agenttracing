sertEqual(result, list(range(15000)))\n        self.assertLess(elapsed, 0.5, f\"took {elapsed:.2f}s\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n", "numLines": 28, "startLine": 1, "totalLines": 28}}}}
