 """Shell-style matching of a path against a glob pattern."""
+
+
+def _read_char(pattern: str, i: int) -> tuple[str, int]:
+    """Read one literal character at ``i``, honouring a backslash escape."""
+    if pattern[i] == "\\" and i + 1 < len(pattern):
+        return pattern[i + 1], i + 2
+    return pattern[i], i + 1
+
+
+def _parse_class(pattern: str, i: int):
+    """Parse a ``[...]`` class starting at ``i``.
+
+    Returns ``((negated, ranges), next_index)``, or ``None`` if the class is
+    never closed, in which case the ``[`` is a literal.
+    """
+    n = len(pattern)
+    j = i + 1
+    negated = j < n and pattern[j] == "!"
+    if negated:
+        j += 1
+    ranges = []
+    first = True
+    while j < n:
+        if pattern[j] == "]" and not first:
+            return (negated, ranges), j + 1
+        first = False
+        lo, j = _read_char(pattern, j)
+        if j + 1 < n and pattern[j] == "-" and pattern[j + 1] != "]":
+            hi, j = _read_char(pattern, j + 1)
+            ranges.append((lo, hi))
+        else:
+            ranges.append((lo, lo))
+    return None
+
+
+def _tokenize(pattern: str) -> list:
+    """Split a pattern into matcher tokens.
+
+    Each token is ``("lit", char)``, ``("one",)``, ``("seg",)`` for ``*``,
+    ``("any",)`` for ``**``, or ``("class", negated, ranges)``.
+    """
+    tokens = []
+    i = 0
+    n = len(pattern)
+    while i < n:
+        c = pattern[i]
+        if c == "*":
+            if i + 1 < n and pattern[i + 1] == "*":
+                tokens.append(("any",))
+                i += 2
+            else:
+                tokens.append(("seg",))
+                i += 1
+        elif c == "?":
+            tokens.append(("one",))
+            i += 1
+        elif c == "[":
+            parsed = _parse_class(pattern, i)
+            if parsed is None:
+                tokens.append(("lit", "["))
+                i += 1
+            else:
+                (negated, ranges), i = parsed
+                tokens.append(("class", negated, ranges))
+        else:
+            ch, i = _read_char(pattern, i)
+            tokens.append(("lit", ch))
+    return tokens
+
+
+def _in_class(ch: str, negated: bool, ranges: list) -> bool:
+    if ch == "/":
+        return False
+    return any(lo <= ch <= hi for lo, hi in ranges) != negated
 
 
