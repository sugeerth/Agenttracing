 """When a cron schedule fires next."""
 
-from datetime import datetime
+import re
+from datetime import datetime, timedelta
+
+_MONTHS = {name: i for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1)}
+_DAYS = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# The Gregorian calendar repeats every 400 years, so a schedule that matches nothing in that span never will.
+_MAX_DAYS = 400 * 366
+
+
+def _value(text: str, names: dict[str, int], lo: int, hi: int) -> int:
+    if text.upper() in names:
+        return names[text.upper()]
+    if not re.fullmatch(r"[0-9]+", text):
+        raise ValueError(f"bad cron value {text!r}")
+    value = int(text)
+    if not lo <= value <= hi:
+        raise ValueError(f"cron value {value} out of range {lo}-{hi}")
+    return value
+
+
+def _field(text: str, lo: int, hi: int, star_hi: int, names: dict[str, int]) -> set[int]:
+    values = set()
+    for item in text.split(","):
+        base, slash, step_text = item.partition("/")
+        step = 1
+        if slash:
+            if not re.fullmatch(r"[0-9]+", step_text) or int(step_text) < 1:
+                raise ValueError(f"bad cron step {step_text!r}")
+            step = int(step_text)
+        if base == "*":
+            start, end = lo, star_hi
+        else:
+            start_text, dash, end_text = base.partition("-")
+            start = _value(start_text, names, lo, hi)
+            if dash:
+                end = _value(end_text, names, lo, hi)
+                if end < start:
+                    raise ValueError(f"cron range {base!r} runs backwards")
+            elif slash:
+                raise ValueError(f"cron step needs * or a range, not {item!r}")
+            else:
+                end = start
+        values.update(range(start, end + 1, step))
+    return values
+
+
+def _parse(expr: str):
+    fields = expr.split(" ")
+    if len(fields) != 5:
+        raise ValueError(f"cron expression needs 5 fields, got {len(fields)}: {expr!r}")
+    minute = _field(fields[0], 0, 59, 59, {})
+    hour = _field(fields[1], 0, 23, 23, {})
+    dom = _field(fields[2], 1, 31, 31, {})
+    month = _field(fields[3], 1, 12, 12, _MONTHS)
+    # 7 is accepted as Sunday, but a bare * means Sunday through Saturday only.
+    dow = {v % 7 for v in _field(fields[4], 0, 7, 6, _DAYS)}
+    return minute, hour, dom, month, dow, fields[2] != "*", fields[4] != "*"
 
 
