 """When a cron schedule fires next."""
 
-from datetime import datetime
+from datetime import datetime, timedelta
+
+MONTH_NAMES = {name: i for i, name in enumerate(
+    ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], start=1)}
+DOW_NAMES = {name: i for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"])}
+
+# Searching this far ahead is enough for any satisfiable expression (Feb 29 recurs at most every 8 years).
+SEARCH_SPAN = timedelta(days=366 * 400)
+
+
+def _value(text: str, lo: int, hi: int, names: dict[str, int] | None) -> int:
+    if text.isdigit() and text.isascii():
+        value = int(text)
+    elif names is not None and text.upper() in names:
+        value = names[text.upper()]
+    else:
+        raise ValueError(f"invalid cron value {text!r}")
+    if not lo <= value <= hi:
+        raise ValueError(f"cron value {value} out of range {lo}-{hi}")
+    return value
+
+
+def _parse_field(field: str, lo: int, hi: int, names: dict[str, int] | None = None) -> set[int]:
+    """Expand one cron field into the set of values it matches.
+
+    ``hi`` bounds explicit values and ``*`` is ``lo..hi``; the caller decides whether 7 is allowed for day of week.
+    """
+    values: set[int] = set()
+    for part in field.split(","):
+        if not part:
+            raise ValueError(f"empty item in cron field {field!r}")
+        base, slash, step_text = part.partition("/")
+        step = 1
+        if slash:
+            if not step_text.isdigit() or not step_text.isascii() or int(step_text) == 0:
+                raise ValueError(f"invalid cron step {step_text!r}")
+            step = int(step_text)
+        if base == "*":
+            start, end = lo, hi
+        elif "-" in base:
+            left, dash, right = base.partition("-")
+            if not dash or "-" in right:
+                raise ValueError(f"invalid cron range {base!r}")
+            start = _value(left, lo, hi, names)
+            end = _value(right, lo, hi, names)
+            if start > end:
+                raise ValueError(f"cron range {base!r} runs backwards")
+        else:
+            if slash:
+                raise ValueError(f"cron step needs * or a range, got {part!r}")
+            start = end = _value(base, lo, hi, names)
+        values.update(range(start, end + 1, step))
+    return values
 
 
