--- a/semver.py
+++ b/semver.py
@@ -8,4 +8,101 @@
     pre-release after "-", optional build metadata after "+" (ignored for
     precedence). A version that is not valid SemVer 2.0.0 raises ValueError.
     """
-    raise NotImplementedError
+    parsed_a = _parse_version(a)
+    parsed_b = _parse_version(b)
+
+    # Compare major, minor, patch
+    if parsed_a['major'] != parsed_b['major']:
+        return -1 if parsed_a['major'] < parsed_b['major'] else 1
+    if parsed_a['minor'] != parsed_b['minor']:
+        return -1 if parsed_a['minor'] < parsed_b['minor'] else 1
+    if parsed_a['patch'] != parsed_b['patch']:
+        return -1 if parsed_a['patch'] < parsed_b['patch'] else 1
+
+    # Compare pre-release versions
+    pre_a = parsed_a['prerelease']
+    pre_b = parsed_b['prerelease']
+
+    # No pre-release > has pre-release
+    if pre_a is None and pre_b is None:
+        return 0
+    if pre_a is None:
+        return 1
+    if pre_b is None:
+        return -1
+
+    return _compare_prerelease(pre_a, pre_b)
+
+
+def _parse_version(version: str) -> dict:
+    # Remove build metadata (after +)
+    version = version.split('+')[0]
+
+    # Split on '-' to separate pre-release
+    if '-' in version:
+        base, prerelease = version.split('-', 1)
+    else:
+        base = version
+        prerelease = None
+
+    # Parse MAJOR.MINOR.PATCH
+    parts = base.split('.')
+    if len(parts) != 3:
+        raise ValueError(f"Invalid version: {version}")
+
+    try:
+        major, minor, patch = int(parts[0]), int(parts[1]), int(parts[2])
+    except ValueError:
+        raise ValueError(f"Invalid version: {version}")
+
+    if major < 0 or minor < 0 or patch < 0:
+        raise ValueError(f"Invalid version: {version}")
+
+    return {
+        'major': major,
+        'minor': minor,
+        'patch': patch,
+        'prerelease': prerelease
+    }
+
+
+def _compare_prerelease(pre_a: str, pre_b: str) -> int:
+    identifiers_a = pre_a.split('.')
+    identifiers_b = pre_b.split('.')
+
+    for i in range(max(len(identifiers_a), len(identifiers_b))):
+        if i >= len(identifiers_a):
+            return -1
+        if i >= len(identifiers_b):
+            return 1
+
+        id_a = identifiers_a[i]
+        id_b = identifiers_b[i]
+
+        # Try to parse as integers
+        try:
+            num_a = int(id_a)
+            is_num_a = True
+        except ValueError:
+            is_num_a = False
+
+        try:
+            num_b = int(id_b)
+            is_num_b = True
+        except ValueError:
+            is_num_b = False
+
+        # Numeric identifiers compared numerically, always precede non-numeric
+        if is_num_a and is_num_b:
+            if num_a != num_b:
+                return -1 if num_a < num_b else 1
+        else:
+            if is_num_a and not is_num_b:
+                return -1
+            if not is_num_a and is_num_b:
+                return 1
+            # Both are non-numeric, compare lexically
+            if id_a != id_b:
+                return -1 if id_a < id_b else 1
+
+    return 0
