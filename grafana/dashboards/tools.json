        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Seconds the agent waited on calls the reading marks as wasted; a reading of the steps, not a measurement of the tool.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
