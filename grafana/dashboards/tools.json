      "description": "The three longest runs of consecutive identical calls to one tool in any one pair report; a retry loop shows here before it shows in the cost.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "thresholds": {
