          },
          "editorMode": "code",
          "expr": "label_join(agentdiff_coevolution_step_flag_delta_lo, \"edge\", \" → \", \"from\", \"to\")",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "label_join(agentdiff_coevolution_step_flag_delta_hi, \"edge\", \" → \", \"from\", \"to\")",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "C"
        }
      ],
      "title": "What does the evolved eval flag with hindsight, step by step?",
