    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The generation the engine ranks first, and its IQM (task-balanced when the section carries one). Read it beside the intervals below: the next generation's interval usually overlaps.",
